<Project>
  <PropertyGroup>
    <VoltraVersion>0.9.9</VoltraVersion>
    <_VoltraLinuxProjectPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'LinuxApp', 'LinuxApp.csproj'))</_VoltraLinuxProjectPath>
    <_VoltraWindowsProjectPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'WindowsApp', 'Voltra.csproj'))</_VoltraWindowsProjectPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFullPath)' == '$(_VoltraWindowsProjectPath)'">
    <Version>$(VoltraVersion)</Version>
    <VoltraProjectLicense Condition="'$(VoltraProjectLicense)' == ''">PolyForm-Noncommercial-1.0.0</VoltraProjectLicense>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectFullPath)' == '$(_VoltraWindowsProjectPath)' Or '$(MSBuildProjectFullPath)' == '$(_VoltraLinuxProjectPath)'">
    <VoltraUpdateRepository Condition="'$(VoltraUpdateRepository)' == ''">zixxi/release-voltra</VoltraUpdateRepository>
    <VoltraUpdatePublicKey Condition="'$(VoltraUpdatePublicKey)' == ''"></VoltraUpdatePublicKey>
  </PropertyGroup>
</Project>
