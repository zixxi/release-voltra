<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Voltra.ico</ApplicationIcon>
    <Product>Voltra</Product>
    <AssemblyTitle>Voltra</AssemblyTitle>
    <Description>Desktop Audio Controller</Description>
    <Version>0.9.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
     <!-- Existing project settings remain here -->
    <VoltraUpdateRepository>zixxi/Voltra</VoltraUpdateRepository>
    <VoltraUpdatePublicKey></VoltraUpdatePublicKey>
    <VoltraProjectLicense>PolyForm-Noncommercial-1.0.0</VoltraProjectLicense>
  </PropertyGroup>

  <!-- Keep the existing ItemGroup sections unchanged -->

  <!-- Compile the current source set so files left by older ZIP extractions
       cannot reintroduce removed features. -->
  <ItemGroup>
    <Compile Include="AudioCoordinator.cs" />
    <Compile Include="DeviceLink.cs" />
    <Compile Include="FieldControls.cs" />
    <Compile Include="MixerForm.cs" />
    <Compile Include="MixerForm.Updates.cs" />
    <Compile Include="MixerVisuals.cs" />
    <Compile Include="OledMixerFont.cs" />
    <Compile Include="OledRenderer.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UiMotion.cs" />
    <Compile Include="VolumeTakeover.cs" />
    <Compile Include="WeatherService.cs" />
    <Compile Include="WindowsAudio.cs" />
    <Compile Include="UpdateService.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(VoltraUpdateRepository)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(VoltraUpdatePublicKey)" />
    <AssemblyMetadata Include="ProjectLicense" Value="$(VoltraProjectLicense)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
</Project>
