<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows application -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Voltra.ico</ApplicationIcon>

    <!-- Application information -->
    <Product>Voltra</Product>
    <AssemblyTitle>Voltra</AssemblyTitle>
    <Description>Desktop Audio Controller</Description>
    <Version>0.9.1</Version>

    <!-- GitHub update configuration -->
    <VoltraUpdateRepository Condition="'$(VoltraUpdateRepository)' == ''">zixxi/release-voltra</VoltraUpdateRepository>

    <!-- RSA-4096 public key -->
    <VoltraUpdatePublicKey Condition="'$(VoltraUpdatePublicKey)' == ''"></VoltraUpdatePublicKey>

    <!-- Project license -->
    <VoltraProjectLicense Condition="'$(VoltraProjectLicense)' == ''">PolyForm-Noncommercial-1.0.0</VoltraProjectLicense>

    <!-- ESP32 firmware flasher SHA-256 -->
    <VoltraFlasherSha256 Condition="'$(VoltraFlasherSha256)' == ''">34AE6FE190B5D1A40C749030EB871E0786DD76EA5F29DFA2AE39DF3EB3B5DC2A</VoltraFlasherSha256>

    <!-- Compiler settings -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Explicit source files -->
  <ItemGroup>
    <Compile Include="AudioCoordinator.cs" />
    <Compile Include="DeviceLink.cs" />
    <Compile Include="FieldControls.cs" />
    <Compile Include="MixerForm.cs" />
    <Compile Include="MixerForm.Updates.cs" />
    <Compile Include="MixerVisuals.cs" />
    <Compile Include="OledMixerFont.cs" />
    <Compile Include="OledRenderer.cs" />
    <Compile Include="PageScroller.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UiMotion.cs" />
    <Compile Include="VolumeTakeover.cs" />
    <Compile Include="WeatherService.cs" />
    <Compile Include="WindowsAudio.cs" />
    <Compile Include="UpdateService.cs" />

    <!-- ESP32 firmware updater -->
    <Compile Include="FirmwareUpdate.cs" />
    <Compile Include="MixerForm.Firmware.cs" />
    <Compile Include="MixerForm.FirmwareDialog.cs" />
  </ItemGroup>

  <!-- Assembly metadata -->
  <ItemGroup>
    <AssemblyMetadata Include="FirmwareFlasherSha256" Value="$(VoltraFlasherSha256)" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(VoltraUpdateRepository)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(VoltraUpdatePublicKey)" />
    <AssemblyMetadata Include="ProjectLicense" Value="$(VoltraProjectLicense)" />
  </ItemGroup>

  <!-- Bundled ESP32 firmware flasher -->
  <ItemGroup Condition="Exists('tools/VoltraFlasher.exe')">
    <None Remove="tools/VoltraFlasher.exe" />
    <Content Include="tools/VoltraFlasher.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

</Project>