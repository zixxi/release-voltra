<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../assets/branding/voltra.ico</ApplicationIcon>
    <Product>Voltra</Product>
    <AssemblyTitle>Voltra</AssemblyTitle>
    <Description>Desktop Audio Controller</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WindowsPaint" />
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="Voltra.Brand.ico" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(VoltraUpdateRepository)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(VoltraUpdatePublicKey)" />
    <AssemblyMetadata Include="ProjectLicense" Value="$(VoltraProjectLicense)" />
  </ItemGroup>
  <ItemGroup Condition="Exists('tools/VoltraFlasher.exe')">
    <None Remove="tools/VoltraFlasher.exe" />
    <Content Include="tools/VoltraFlasher.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Voltra.Core/OledFrame.cs" Link="OledFrame.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <Target Name="PinVoltraFlasher" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_BundledVoltraFlasherSha256>$(VoltraFlasherSha256)</_BundledVoltraFlasherSha256>
    </PropertyGroup>
    <GetFileHash Files="$(MSBuildProjectDirectory)/tools/VoltraFlasher.exe" Algorithm="SHA256"
                 Condition="Exists('$(MSBuildProjectDirectory)/tools/VoltraFlasher.exe')">
      <Output TaskParameter="Hash" PropertyName="_BundledVoltraFlasherSha256" />
    </GetFileHash>
    <Error Condition="'$(VoltraFlasherSha256)' != '' And '$(VoltraFlasherSha256)' != '$(_BundledVoltraFlasherSha256)'"
           Text="VoltraFlasherSha256 does not match tools/VoltraFlasher.exe. Rebuild with Build-VoltraFlasher.ps1 or pass the hash of the executable being packaged." />
    <ItemGroup>
      <AssemblyMetadata Include="FirmwareFlasherSha256" Value="$(_BundledVoltraFlasherSha256)" />
    </ItemGroup>
  </Target>
</Project>
