@@ -0,0 +1,34 @@
+# Voltra for Linux
+
+Voltra uses the existing five-knob ESP32-S3-Zero and 128×64 OLED over USB. The Linux app uses Avalonia and controls PipeWire's default output and application playback streams through `pipewire-pulse`. Its settings live in `$XDG_CONFIG_HOME/Voltra/`, falling back to `~/.config/Voltra/`.
+
+## Run on Ubuntu or Fedora x86-64
+
+Use a regular KDE Plasma or GNOME session with PipeWire, WirePlumber and X11 or XWayland. Most desktop installations already have the audio services and display libraries. Install the `pactl` client if missing.
+
+| Distribution | Install `pactl` |
+| --- | --- |
+| Ubuntu | `sudo apt install pulseaudio-utils` |
+| Fedora | `sudo dnf install pulseaudio-utils` |
+
+Confirm that `pactl info` reports **PulseAudio (on PipeWire …)**. For minimal installations, install the distribution's PipeWire Pulse compatibility package and WirePlumber. Avalonia needs X11 libraries and fontconfig, plus XWayland for Wayland sessions. The self-contained package includes .NET.
+
+1. Extract the Linux archive to a permanent directory and run `./LinuxApp` from that directory.
+2. Connect the controller using a USB data cable. Voltra automatically checks native Espressif USB serial ports and prefers stable `/dev/serial/by-id/` paths. Select a port in **Settings → Device connection** if you are using a USB-serial bridge.
+3. If the Dashboard reports a permissions problem, close other serial tools and check the port's group with `ls -l /dev/ttyACM0`, substituting your actual device. Add your user to the device's serial group if needed. On Ubuntu and Fedora it is commonly `dialout` (`sudo usermod -aG dialout "$USER"`). Log out and back in after changing membership. Run Voltra as your normal user.
+4. Start playback in the apps you want to control. On **Dashboard**, select an application or enter its ID, executable name, or name, then apply the mapping. **Master output** follows the current default output. Soft takeover waits for the physical knob to reach or cross the current volume. Immediate takeover acts after the movement threshold.
+
+**OLED** supports mixer levels, clock/date, weather, local images and GIFs, and PC uptime. The preview uses the same framebuffer sent over serial. Standalone behavior after a disconnect depends on the installed firmware, and weather needs network access. Application updates and firmware version detection are available from **Settings**. Application updates link to the Linux package for manual installation. Flash the controller with your existing firmware workflow.
+
+**Launch Voltra at system startup** creates an XDG Autostart entry at `$XDG_CONFIG_HOME/autostart/voltra.desktop` (normally `~/.config/autostart/voltra.desktop`). It passes `--minimized` to the same executable. A desktop with an active StatusNotifier host, such as KDE Plasma or GNOME with an AppIndicator extension, can restore Voltra from its tray menu. Other sessions open the main window so its controls are still accessible. Keep the executable at its configured path for startup to find it.
+
+## Build and package
+
+From the repository root, use the .NET 10 SDK.
+
+```sh
+dotnet run --project LinuxApp/LinuxApp.csproj
+dotnet publish LinuxApp/LinuxApp.csproj -c Release -r linux-x64 --self-contained true -o publish/linux-x64
+```
+
+See [RELEASING.md](../RELEASING.md#linux-releases) for the portable archive and GitHub release naming.
diff --git a/LinuxApp/Services/LinuxDeviceService.cs b/LinuxApp/Services/LinuxDeviceService.cs
new file mode 100644
index 0000000..6546919
--- /dev/null
+++ b/LinuxApp/Services/LinuxDeviceService.cs
@@ -0,0 +1,271 @@
+using System.IO.Ports;
+using System.Security.Cryptography;
+using System.Text;
+using Voltra;
+
+namespace Voltra.Linux;
+
+internal sealed record DeviceSnapshot(string Status, string Display, string[] Ports, int[]? Levels = null,
+    string? Port = null, string? Firmware = null);
+internal sealed record DisplayFrame(byte[] Pixels, DisplayPage Page, int Flags, uint Media);
+
+internal sealed class LinuxDeviceService : IAsyncDisposable
+{
+    private readonly CancellationTokenSource stop = new();
+    private readonly Task worker;
+    private readonly Func<Settings> settings;
+    private readonly Func<string[]> findPorts;
+    private DeviceSnapshot snapshot = new("Looking for Voltra…", "OLED waiting", []);
+    private DisplayFrame? display;
+    private string? lastPort;
+    internal DeviceSnapshot Snapshot => Volatile.Read(ref snapshot);
+    internal void SetFrame(DisplayFrame value) => Volatile.Write(ref display, value);
+
+    internal LinuxDeviceService(Func<Settings> settings, Func<string[]>? findPorts = null)
+    {
+        this.settings = settings;
+        this.findPorts = findPorts ?? FindPorts;
+        worker = Task.Run(() => RunAsync(stop.Token));
+    }
+
+    private async Task RunAsync(CancellationToken token)
+    {
+        while (!token.IsCancellationRequested)
+        {
+            string requested = settings().Port;
+            var ports = findPorts();
+            string[] candidates = requested.Length == 0
+                ? ports.Where(IsEspressifUsb).OrderByDescending(port => port == lastPort).ToArray()
+                : ports.Contains(requested) ? [requested] : [];
+            Publish(requested.Length > 0 && candidates.Length == 0 ? $"Waiting for {requested}" :
+                "Connect a Voltra controller or select its port in Settings", "OLED waiting", ports);
+            foreach (string port in candidates)
+            {
+                if (requested != settings().Port || token.IsCancellationRequested) break;
+                try { await ReadPortAsync(port, requested, ports, token); }
+                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or
+                    TimeoutException or InvalidOperationException or ArgumentException)
+                {
+                    string message = ex is UnauthorizedAccessException
+                        ? $"Cannot open {port}. Check serial group permissions and that the port is free."
+                        : $"{port}: {ex.Message}";
+                    Publish(message, "OLED waiting", ports);
+                }
+            }
+            await Task.Delay(candidates.Length == 0 ? 900 : 700, token);
+        }
+    }
+
+    private async Task ReadPortAsync(string port, string requested, string[] ports, CancellationToken token)
+    {
+        using var serial = new SerialPort(port, 115200) { WriteTimeout = 250, NewLine = "\n", Encoding = Encoding.ASCII };
+        bool identified = false, ready = false, standalone = false;
+        string? firmware = null;
+        string status = "OLED waiting";
+        try
+        {
+            Publish($"Checking {port}…", status, ports);
+            serial.Open();
+            try { serial.DtrEnable = true; }
+            catch (IOException) { /* PTYs and some USB bridges don't expose modem signals. */ }
+            serial.DiscardInBuffer();
+            var nonce = Convert.ToHexString(RandomNumberGenerator.GetBytes(4));
+            var buffer = new StringBuilder(160);
+            bool overflow = false;
+            long opened = Environment.TickCount64, lastPacket = opened, nextHello = 0, nextPage = 0, nextFrame = 0,
+                ackDeadline = 0, lastFrame = 0, nextScan = 0;
+            int[]? levels = null;
+            var parsed = new int[5];
+            DisplayFrame? sending = null, sent = null;
+            Channel[]? configuredChannels = null;
+            string[]? labels = null;
+            string[] currentLabels = [];
+            (DisplayPage Page, int Flags, uint Media)? pageState = null;
+            int chunk = 0;
+            while (!token.IsCancellationRequested && settings().Port == requested)
+            {
+                long now = Environment.TickCount64;
+                if (now >= nextScan)
+                {
+                    ports = findPorts();
+                    nextScan = now + 1500;
+                }
+                foreach (char ch in serial.ReadExisting())
+                {
+                    if (ch != '\n')
+                    {
+                        if (buffer.Length < 160) buffer.Append(ch);
+                        else overflow = true;
+                        continue;
+                    }
+                    string line = overflow ? "" : buffer.ToString().TrimEnd('\r');
+                    buffer.Clear();
+                    overflow = false;
+                    if (!identified)
+                    {
+                        if (!SerialProtocol.IsIdentity(line, nonce)) continue;
+                        identified = true;
+                        nextHello = 0;
+                        continue;
+                    }
+                    if (SerialProtocol.TryLevels(line, parsed))
+                    {
+                        lastPacket = now;
+                        if (levels is null || !levels.AsSpan().SequenceEqual(parsed)) levels = parsed.ToArray();
+                    }
+                    else if (line is "OLED,READY,128,64,3" or "OLED,READY,128,64,2")
+                    {
+                        standalone = line.EndsWith(",3", StringComparison.Ordinal);
+                        ready = true;
+                        status = "OLED ready";
+                    }
+                    else if (line == "OLED,ABSENT")
+                    {
+                        ready = standalone = false;
+                        labels = null;
+                        sent = sending = null;
+                        pageState = null;
+                        ackDeadline = 0;
+                        status = "OLED not detected";
+                    }
+                    else if (sending is not null && ackDeadline != 0 && line == $"OLED,ACK,{chunk}")
+                    {
+                        ackDeadline = 0;
+                        if (++chunk == 4)
+                        {
+                            sent = sending;
+                            sending = null;
+                            lastFrame = now;
+                            status = "OLED ready";
+                        }
+                    }
+                    else firmware ??= SerialProtocol.FirmwareVersion(line, nonce);
+                }
+
+                if (now >= nextHello)
+                {
+                    if (!identified) serial.WriteLine($"@H,{nonce}");
+                    else
+                    {
+                        serial.WriteLine("@Q");
+                        if (firmware is null) serial.WriteLine($"@I,{nonce}");
+                    }
+                    nextHello = now + (identified ? 2500 : 240);
+                }
+                if (!identified && now - opened > 2500) throw new IOException("Voltra identity was not confirmed");
+                if (identified && now - lastPacket > 2600) throw new IOException("Voltra knob data stopped");
+                if (identified && levels is not null)
+                {
+                    lastPort = port;
+                    Publish("Controller connected", status, ports, levels, port, firmware);
+                }
+                var frame = Volatile.Read(ref display);
+                if (ready && levels is not null && frame is not null)
+                {
+                    var channels = settings().Channels;
+                    if (configuredChannels != channels)
+                    {
+                        configuredChannels = channels;
+                        currentLabels = channels.Select(c => SerialProtocol.Ascii(c.Label, 18)).ToArray();
+                    }
+                    if (labels is null || !labels.AsSpan().SequenceEqual(currentLabels))
+                    {
+                        for (int i = 0; i < 5; i++) serial.WriteLine($"@L{i + 1},{currentLabels[i]}");
+                        labels = currentLabels;
+                    }
+                    var selectedPage = (frame.Page, frame.Flags, frame.Media);
+                    if (standalone && sending is null && (pageState != selectedPage || now >= nextPage))
+                    {
+                        serial.WriteLine(SerialProtocol.PageCommand((int)frame.Page, frame.Flags, DateTimeOffset.Now, frame.Media));
+                        if (pageState != selectedPage) sent = null;
+                        pageState = selectedPage;
+                        nextPage = now + 1500;
+                    }
+                    if (ackDeadline != 0 && now >= ackDeadline)
+                    {
+                        sending = sent = null;
+                        ackDeadline = 0;
+                        nextFrame = now + 750;
+                        status = "OLED transfer timed out; retrying";
+                    }
+                    if (sending is null && now >= nextFrame &&
+                        (sent is null || !sent.Pixels.AsSpan().SequenceEqual(frame.Pixels) || now - lastFrame >= 2500))
+                    {
+                        sending = frame;
+                        chunk = 0;
+                        nextFrame = now + 145;
+                    }
+                    if (sending is not null && ackDeadline == 0)
+                    {
+                        serial.WriteLine(SerialProtocol.FrameChunk(sending.Pixels, chunk));
+                        ackDeadline = now + 850;
+                    }
+                }
+                await Task.Delay(12, token);
+            }
+        }
+        finally
+        {
+            if (serial.IsOpen && identified && standalone)
+            {
+                try { serial.WriteLine("@D"); }
+                catch (Exception ex) when (ex is IOException or TimeoutException or InvalidOperationException)
+                { Console.Error.WriteLine($"Could not notify {port} of disconnection: {ex.Message}"); }
+            }
+        }
+    }
+
+    private void Publish(string status, string oled, string[] ports, int[]? levels = null, string? port = null, string? firmware = null) =>
+        Volatile.Write(ref snapshot, new(status, oled, ports, levels, port, firmware));
+
+    internal static string[] FindPorts()
+    {
+        try
+        {
+            var paths = new List<string>();
+            var targets = new HashSet<string>(StringComparer.Ordinal);
+            if (Directory.Exists("/dev/serial/by-id"))
+                foreach (string path in Directory.EnumerateFiles("/dev/serial/by-id").Order())
+                {
+                    var target = File.ResolveLinkTarget(path, true)?.FullName;
+                    if (target is not null && File.Exists(target) && targets.Add(target)) paths.Add(path);
+                }
+            foreach (string pattern in new[] { "ttyACM*", "ttyUSB*" })
+                foreach (string path in Directory.EnumerateFiles("/dev", pattern).Order())
+                    if (targets.Add(path)) paths.Add(path);
+            return paths.ToArray();
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        {
+            Console.Error.WriteLine($"Serial discovery: {ex.Message}");
+            return [];
+        }
+    }
+
+    private static bool IsEspressifUsb(string path)
+    {
+        try
+        {
+            string tty = Path.GetFileName(File.ResolveLinkTarget(path, true)?.FullName ?? path);
+            var device = Directory.ResolveLinkTarget($"/sys/class/tty/{tty}/device", true) as DirectoryInfo;
+            for (var directory = device; directory is not null; directory = directory.Parent)
+            {
+                string vendor = Path.Combine(directory.FullName, "idVendor");
+                string product = Path.Combine(directory.FullName, "idProduct");
+                if (File.Exists(vendor) && File.Exists(product))
+                    return File.ReadAllText(vendor).Trim() == "303a" && File.ReadAllText(product).Trim() == "1001";
+            }
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+        { Console.Error.WriteLine($"USB identity for {path}: {ex.Message}"); }
+        return false;
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        stop.Cancel();
+        try { await worker; }
+        catch (OperationCanceledException) { }
+        finally { stop.Dispose(); }
+    }
+}
diff --git a/LinuxApp/Services/LinuxSettingsService.cs b/LinuxApp/Services/LinuxSettingsService.cs
new file mode 100644
index 0000000..89d4fb5
--- /dev/null
+++ b/LinuxApp/Services/LinuxSettingsService.cs
@@ -0,0 +1,102 @@
+using System.Text.Json;
+using Avalonia.Media;
+using Voltra;
+
+namespace Voltra.Linux;
+
+internal sealed record Channel(string Label, string Target);
+internal enum DisplayPage { Mixer, Clock, Weather, Image, Uptime }
+internal enum SeparatorMode { Automatic, BeforeChannelFive, None }
+
+internal sealed record Settings
+{
+    internal const string Master = "@master";
+    internal const string DefaultAccent = "#B78BFA";
+    public Channel[] Channels { get; init; } =
+        [new("Spotify", "spotify"), new("Discord", "discord"), new("Firefox", "firefox"),
+         new("Game", ""), new("Master", Master)];
+    public string Theme { get; init; } = "Dark";
+    public string Accent { get; init; } = DefaultAccent;
+    public string Port { get; init; } = "";
+    public string City { get; init; } = "";
+    public string Media { get; init; } = "";
+    public DisplayPage Page { get; init; }
+    public SeparatorMode Separator { get; init; }
+    public bool TwelveHour { get; init; }
+    public bool Sync { get; init; } = true;
+    public KnobTakeover Takeover { get; init; }
+    public int NoiseThreshold { get; init; } = 2;
+    public bool Startup { get; init; }
+}
+
+internal static class LinuxSettingsService
+{
+    private static readonly JsonSerializerOptions Json = new() { WriteIndented = true };
+    internal static string ConfigHome
+    {
+        get
+        {
+            string? configured = Environment.GetEnvironmentVariable("XDG_CONFIG_HOME");
+            return Path.IsPathFullyQualified(configured ?? "") ? configured! :
+                Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".config");
+        }
+    }
+
+    internal static string Folder => Path.Combine(ConfigHome, "Voltra");
+    private static string PathName => Path.Combine(Folder, "settings.json");
+
+    internal static Settings Read(out string? error)
+    {
+        error = null;
+        try
+        {
+            if (!File.Exists(PathName)) return new();
+            var value = JsonSerializer.Deserialize<Settings>(File.ReadAllText(PathName)) ?? new();
+            var defaults = new Settings();
+            return value with
+            {
+                Channels = Enumerable.Range(0, 5).Select(i =>
+                {
+                    var channel = value.Channels?.ElementAtOrDefault(i) ?? defaults.Channels[i];
+                    return channel with { Label = channel.Label ?? "", Target = channel.Target ?? "" };
+                }).ToArray(),
+                Theme = value.Theme is "Dark" or "Light" or "System" ? value.Theme : defaults.Theme,
+                Accent = TryAccent(value.Accent, out _) ? value.Accent : defaults.Accent,
+                Port = value.Port ?? "", City = value.City ?? "", Media = value.Media ?? "",
+                Page = Enum.IsDefined(value.Page) ? value.Page : defaults.Page,
+                Separator = Enum.IsDefined(value.Separator) ? value.Separator : defaults.Separator,
+                Takeover = Enum.IsDefined(value.Takeover) ? value.Takeover : defaults.Takeover,
+                NoiseThreshold = Math.Clamp(value.NoiseThreshold, 1, 5)
+            };
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
+        {
+            error = $"Could not load preferences: {ex.Message}";
+            return new();
+        }
+    }
+
+    internal static bool TryAccent(string? text, out Color color)
+    {
+        color = default;
+        return text is { Length: 7 } && text[0] == '#' && text.Skip(1).All(Uri.IsHexDigit) &&
+            Color.TryParse(text, out color);
+    }
+
+    internal static Task SaveAsync(Settings value) => Task.Run(() => AtomicWrite(PathName, JsonSerializer.Serialize(value, Json)));
+
+    internal static void AtomicWrite(string destination, string value)
+    {
+        Directory.CreateDirectory(Path.GetDirectoryName(destination)!);
+        string temporary = destination + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            File.WriteAllText(temporary, value);
+            File.Move(temporary, destination, overwrite: true);
+        }
+        finally
+        {
+            if (File.Exists(temporary)) File.Delete(temporary);
+        }
+    }
+}
diff --git a/LinuxApp/Services/LinuxStartupService.cs b/LinuxApp/Services/LinuxStartupService.cs
new file mode 100644
index 0000000..4fecf44
--- /dev/null
+++ b/LinuxApp/Services/LinuxStartupService.cs
@@ -0,0 +1,43 @@
+namespace Voltra.Linux;
+
+internal static class LinuxStartupService
+{
+    private static string DesktopFile => Path.Combine(LinuxSettingsService.ConfigHome, "autostart", "voltra.desktop");
+
+    internal static Task ApplyAsync(bool enabled) => Task.Run(() =>
+    {
+        if (!enabled)
+        {
+            File.Delete(DesktopFile);
+            return;
+        }
+        string executable = Environment.ProcessPath ?? throw new IOException("Could not locate Voltra.");
+        // A framework-hosted development launch needs both the dotnet executable and the DLL.
+        string invocation = Path.GetFileName(executable) == "dotnet"
+            ? $"{Quote(executable)} {Quote(typeof(LinuxStartupService).Assembly.Location)}" : Quote(executable);
+        LinuxSettingsService.AtomicWrite(DesktopFile, "[Desktop Entry]\nType=Application\nName=Voltra\n" +
+            $"Exec={invocation} --minimized\nTerminal=false\n");
+    });
+
+    internal static async Task<bool> IsTrayAvailableAsync(CancellationToken token)
+    {
+        try
+        {
+            string result = await ProcessCommand.RunAsync("busctl", token, "--user", "--no-pager", "--timeout=1s",
+                "get-property", "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
+                "org.kde.StatusNotifierWatcher", "IsStatusNotifierHostRegistered");
+            return result.Trim() == "b true";
+        }
+        catch (Exception ex) when (ex is IOException or System.ComponentModel.Win32Exception or TimeoutException)
+        { return false; }
+    }
+
+    private static string Quote(string value)
+    {
+        if (value.Any(char.IsControl)) throw new IOException("The executable path contains control characters.");
+        // Escape the Exec command first, then the desktop entry string containing it.
+        string quoted = value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("`", "\\`")
+            .Replace("$", "\\$").Replace("%", "%%");
+        return "\"" + quoted.Replace("\\", "\\\\") + "\"";
+    }
+}
diff --git a/LinuxApp/Services/LinuxUpdateService.cs b/LinuxApp/Services/LinuxUpdateService.cs
new file mode 100644
index 0000000..ad50bd0
--- /dev/null
+++ b/LinuxApp/Services/LinuxUpdateService.cs
@@ -0,0 +1,47 @@
+using System.Net.Http.Json;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using Voltra;
+
+namespace Voltra.Linux;
+
+internal sealed record LinuxRelease(Version Version, string Notes, Uri Package);
+
+internal static class LinuxUpdateService
+{
+    internal const string Repository = "zixxi/release-voltra";
+    internal static Version Version { get; } = new(typeof(LinuxUpdateService).Assembly
+        .GetName().Version!.ToString(3));
+    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(10) };
+
+    internal static async Task<LinuxRelease?> CheckAsync(CancellationToken token)
+    {
+        if (RuntimeInformation.ProcessArchitecture != Architecture.X64) return null;
+        using var request = new HttpRequestMessage(HttpMethod.Get, $"https://api.github.com/repos/{Repository}/releases?per_page=100");
+        request.Headers.UserAgent.ParseAdd($"Voltra-Linux/{Version}");
+        using var response = await Http.SendAsync(request, token);
+        response.EnsureSuccessStatusCode();
+        var body = await response.Content.ReadFromJsonAsync<JsonElement>(cancellationToken: token);
+        return FindLatest(body, Version);
+    }
+
+    internal static LinuxRelease? FindLatest(JsonElement body, Version current)
+    {
+        LinuxRelease? latest = null;
+        foreach (var item in body.EnumerateArray())
+        {
+            if (item.GetProperty("draft").GetBoolean() || item.GetProperty("prerelease").GetBoolean()) continue;
+            string tag = item.GetProperty("tag_name").GetString() ?? "";
+            if (!tag.StartsWith("linux-v", StringComparison.Ordinal) || !SerialProtocol.StableVersion().IsMatch(tag[7..]) ||
+                !System.Version.TryParse(tag[7..], out var version) || version <= current ||
+                (latest is not null && version <= latest.Version)) continue;
+
+            string package = $"Voltra-{version}-linux-x64.tar.gz";
+            if (!item.GetProperty("assets").EnumerateArray().Any(asset => asset.GetProperty("name").GetString() == package &&
+                asset.GetProperty("state").GetString() == "uploaded")) continue;
+            latest = new(version, item.GetProperty("body").GetString() ?? "",
+                new Uri($"https://github.com/{Repository}/releases/download/{tag}/{package}"));
+        }
+        return latest;
+    }
+}
diff --git a/LinuxApp/Services/OledDisplayService.cs b/LinuxApp/Services/OledDisplayService.cs
new file mode 100644
index 0000000..b1a76f3
--- /dev/null
+++ b/LinuxApp/Services/OledDisplayService.cs
@@ -0,0 +1,274 @@
+using SkiaSharp;
+using Voltra;
+
+namespace Voltra.Linux;
+
+internal sealed record DisplaySnapshot(string Message, byte[] Pixels);
+internal sealed record DisplayMedia(uint Id, (byte[] Pixels, int Milliseconds)[] Frames, int TotalDuration);
+
+internal sealed class OledDisplayService : IAsyncDisposable
+{
+    private readonly CancellationTokenSource stop = new();
+    private readonly Task worker;
+    private readonly Func<Settings> settings;
+    private readonly LinuxDeviceService device;
+    private readonly PipeWireAudioService audio;
+    private DisplaySnapshot snapshot = new("", new byte[SerialProtocol.FrameSize]);
+    internal DisplaySnapshot Snapshot => Volatile.Read(ref snapshot);
+
+    internal OledDisplayService(Func<Settings> settings, LinuxDeviceService device, PipeWireAudioService audio)
+    {
+        this.settings = settings;
+        this.device = device;
+        this.audio = audio;
+        worker = Task.Run(() => RunAsync(stop.Token));
+    }
+
+    private async Task RunAsync(CancellationToken token)
+    {
+        using var weatherService = new WeatherService();
+        WeatherReading? weather = null;
+        Task<WeatherReading>? weatherJob = null;
+        string city = "", lastQuery = "", weatherStatus = "";
+        long nextWeather = 0;
+        DisplayMedia? media = null;
+        Task<DisplayMedia>? mediaJob = null;
+        string mediaPath = "", lastMedia = "", mediaStatus = "";
+        long animationStart = 0;
+        try
+        {
+            while (!token.IsCancellationRequested)
+            {
+                var config = settings();
+                long now = Environment.TickCount64;
+                if (city != config.City)
+                {
+                    city = config.City;
+                    weather = null;
+                    weatherStatus = "";
+                    nextWeather = 0;
+                }
+                if (weatherJob is { IsCompleted: true })
+                {
+                    try
+                    {
+                        var reading = await weatherJob;
+                        if (city == lastQuery) { weather = reading; weatherStatus = ""; }
+                    }
+                    catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or
+                        System.Text.Json.JsonException or OperationCanceledException or KeyNotFoundException)
+                    {
+                        if (city == lastQuery) weatherStatus = $"Weather: {ex.Message}";
+                    }
+                    weatherJob = null;
+                }
+                if (config.Page == DisplayPage.Weather && city.Length > 0 && weatherJob is null && now >= nextWeather)
+                {
+                    lastQuery = city;
+                    weatherJob = weatherService.ReadAsync(city, token);
+                    nextWeather = now + 600_000;
+                }
+
+                if (mediaPath != config.Media)
+                {
+                    mediaPath = config.Media;
+                    if (mediaJob is null) lastMedia = "";
+                    media = null;
+                    mediaStatus = "";
+                }
+                if (mediaJob is { IsCompleted: true })
+                {
+                    try
+                    {
+                        var loaded = await mediaJob;
+                        if (lastMedia == mediaPath)
+                        {
+                            media = loaded;
+                            animationStart = now;
+                            mediaStatus = $"{Path.GetFileName(mediaPath)} · {media.Frames.Length} frames";
+                        }
+                    }
+                    catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException)
+                    {
+                        if (lastMedia == mediaPath) mediaStatus = $"Media: {ex.Message}";
+                    }
+                    mediaJob = null;
+                }
+                if (config.Page == DisplayPage.Image && mediaPath.Length > 0 && lastMedia != mediaPath && mediaJob is null)
+                {
+                    lastMedia = mediaPath;
+                    string path = mediaPath;
+                    mediaJob = Task.Run(() => DecodeMedia(path, token), token);
+                }
+
+                byte[] pixels = config.Page switch
+                {
+                    DisplayPage.Mixer => Mixer(config, audio.Snapshot.Volumes),
+                    DisplayPage.Clock => TextFrame(DateTime.Now.ToString("ddd, dd MMM"),
+                        DateTime.Now.ToString(config.TwelveHour ? "hh:mm tt" : "HH:mm"), DateTime.Now.ToString("yyyy")),
+                    DisplayPage.Weather => weather is null ? TextFrame("WEATHER",
+                        city.Length == 0 ? "SET CITY" : weatherStatus.Length > 0 ? "UNAVAILABLE" : "LOADING", city)
+                        : TextFrame(weather.City, $"{weather.Temperature:0} C", weather.Condition),
+                    DisplayPage.Image => media is null ? TextFrame("IMAGE / GIF", "VOLTRA", "SELECT A FILE")
+                        : FrameAt(media, now - animationStart),
+                    _ => TextFrame("PC UPTIME", Uptime(), "VOLTRA")
+                };
+                string message = config.Page switch
+                {
+                    DisplayPage.Image => mediaStatus,
+                    DisplayPage.Weather => weatherStatus,
+                    _ => ""
+                };
+                if (Snapshot.Pixels.AsSpan().SequenceEqual(pixels)) pixels = Snapshot.Pixels;
+                else Volatile.Write(ref snapshot, new(message, pixels));
+                if (Snapshot.Message != message) Volatile.Write(ref snapshot, new(message, pixels));
+                device.SetFrame(new(pixels, config.Page, config.TwelveHour ? 1 : 0,
+                    config.Page == DisplayPage.Image ? media?.Id ?? 0 : 0));
+                await Task.Delay(config.Page == DisplayPage.Image ? 75 : 125, token);
+            }
+        }
+        finally
+        {
+            if (weatherJob is not null)
+                try { await weatherJob; }
+                catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or
+                    System.Text.Json.JsonException or OperationCanceledException or KeyNotFoundException) { }
+            if (mediaJob is not null)
+                try { await mediaJob; }
+                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException
+                    or ArgumentException or OperationCanceledException) { }
+        }
+    }
+
+    internal static byte[] Mixer(Settings config, int?[] values)
+    {
+        var frame = new byte[SerialProtocol.FrameSize];
+        int gaps = config.Separator == SeparatorMode.BeforeChannelFive ? 1 << 3 : 0;
+        if (config.Separator == SeparatorMode.Automatic)
+            for (int i = 0; i < 5; i++)
+                if (config.Channels[i].Target.Equals(Settings.Master, StringComparison.OrdinalIgnoreCase))
+                {
+                    if (i > 0) gaps |= 1 << (i - 1);
+                    if (i < 4) gaps |= 1 << i;
+                }
+
+        for (int i = 0; i < 5; i++)
+        {
+            int y = i * 11 + 1;
+            string label = SerialProtocol.Ascii(config.Channels[i].Label, 18);
+            if (OledMixerFont.Measure(label) > 43)
+            {
+                do { label = label[..^1]; } while (OledMixerFont.Measure(label + ".") > 43);
+                label += ".";
+            }
+            OledMixerFont.Draw(frame, label, 1, y + 1);
+            int fill = (values[i].GetValueOrDefault() * 56 + 50) / 100;
+            for (int x = 0; x < 56; x++)
+            {
+                OledMixerFont.Pixel(frame, 46 + x, y + 4);
+                if (x >= fill) continue;
+                OledMixerFont.Pixel(frame, 46 + x, y + 3);
+                OledMixerFont.Pixel(frame, 46 + x, y + 5);
+            }
+            string level = values[i] is int value ? $"{value}%" : "--";
+            OledMixerFont.Draw(frame, level, 127 - OledMixerFont.Measure(level), y + 1);
+            if ((gaps & (1 << i)) != 0)
+                for (int x = 1; x < 127; x++) OledMixerFont.Pixel(frame, x, y + 9);
+        }
+        return frame;
+    }
+
+    private static byte[] TextFrame(string top, string middle, string bottom)
+    {
+        var frame = new byte[SerialProtocol.FrameSize];
+        Center(top, 5, 1);
+        Center(middle, 24, 2);
+        Center(bottom, 52, 1);
+        return frame;
+
+        void Center(string text, int y, int scale)
+        {
+            text = SerialProtocol.Ascii(text, 128 / (5 * scale));
+            int width = OledMixerFont.Measure(text);
+            int left = (128 - width * scale) / 2;
+            if (scale == 1) { OledMixerFont.Draw(frame, text, left, y); return; }
+            var glyphs = new byte[SerialProtocol.FrameSize];
+            OledMixerFont.Draw(glyphs, text, 0, 0);
+            for (int row = 0; row < 7; row++)
+                for (int col = 0; col < width; col++)
+                    if ((glyphs[row * 16 + col / 8] & (0x80 >> (col & 7))) != 0)
+                        for (int dy = 0; dy < scale; dy++)
+                            for (int dx = 0; dx < scale; dx++)
+                                OledMixerFont.Pixel(frame, left + col * scale + dx, y + row * scale + dy);
+        }
+    }
+
+    private static string Uptime()
+    {
+        var duration = TimeSpan.FromMilliseconds(Environment.TickCount64);
+        return duration.Days > 0 ? $"{duration.Days}D {duration.Hours:00}H" : $"{duration.Hours:00}:{duration.Minutes:00}:{duration.Seconds:00}";
+    }
+
+    private static byte[] FrameAt(DisplayMedia media, long elapsed)
+    {
+        long offset = elapsed % media.TotalDuration;
+        foreach (var frame in media.Frames)
+        {
+            if (offset < frame.Milliseconds) return frame.Pixels;
+            offset -= frame.Milliseconds;
+        }
+        return media.Frames[^1].Pixels;
+    }
+
+    internal static DisplayMedia DecodeMedia(string path, CancellationToken token)
+    {
+        if (new FileInfo(path).Length > 25 * 1024 * 1024)
+            throw new IOException("Choose an image or GIF smaller than 25 MiB.");
+        using var stream = File.OpenRead(path);
+        using var codec = SKCodec.Create(stream) ?? throw new IOException("Could not decode this image.");
+        if ((long)codec.Info.Width * codec.Info.Height > 4_000_000)
+            throw new IOException("Choose an image smaller than four megapixels.");
+        int count = Math.Max(1, codec.FrameCount);
+        if (count > 300) throw new IOException("Choose a GIF with at most 300 frames.");
+        var frames = new (byte[] Pixels, int Milliseconds)[count];
+        var info = new SKImageInfo(codec.Info.Width, codec.Info.Height, SKColorType.Bgra8888, SKAlphaType.Premul);
+        using var bitmap = new SKBitmap(info);
+        using var oled = new SKBitmap(128, 64);
+        using var canvas = new SKCanvas(oled);
+        using var paint = new SKPaint { FilterQuality = SKFilterQuality.Medium };
+        var metadata = codec.FrameInfo;
+        float scale = Math.Min(128f / info.Width, 64f / info.Height);
+        float width = info.Width * scale, height = info.Height * scale;
+        var bounds = SKRect.Create((128 - width) / 2, (64 - height) / 2, width, height);
+        for (int i = 0; i < count; i++)
+        {
+            token.ThrowIfCancellationRequested();
+            // The codec decodes any required earlier GIF frames when no prior frame is provided.
+            var result = codec.GetPixels(info, bitmap.GetPixels(), new SKCodecOptions(i));
+            if (result != SKCodecResult.Success) throw new IOException($"Image frame {i + 1} could not be decoded: {result}.");
+            canvas.Clear(SKColors.Black);
+            canvas.DrawBitmap(bitmap, bounds, paint);
+            canvas.Flush();
+            var packed = new byte[SerialProtocol.FrameSize];
+            for (int y = 0; y < 64; y++)
+                for (int x = 0; x < 128; x++)
+                {
+                    SKColor pixel = oled.GetPixel(x, y);
+                    if (pixel.Red * 299 + pixel.Green * 587 + pixel.Blue * 114 >= 128_000)
+                        OledMixerFont.Pixel(packed, x, y);
+                }
+            frames[i] = (packed, Math.Max(75, metadata.Length > i ? metadata[i].Duration : 100));
+        }
+        uint id = System.Buffers.Binary.BinaryPrimitives.ReadUInt32LittleEndian(
+            System.Security.Cryptography.SHA256.HashData(frames.SelectMany(frame => frame.Pixels).ToArray()));
+        return new(id == 0 ? 1u : id, frames, frames.Sum(frame => frame.Milliseconds));
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        stop.Cancel();
+        try { await worker; }
+        catch (OperationCanceledException) { }
+        finally { stop.Dispose(); }
+    }
+}
diff --git a/LinuxApp/Services/PipeWireAudioService.cs b/LinuxApp/Services/PipeWireAudioService.cs
new file mode 100644
index 0000000..f3f4fc6
--- /dev/null
+++ b/LinuxApp/Services/PipeWireAudioService.cs
@@ -0,0 +1,242 @@
+using System.ComponentModel;
+using System.Globalization;
+using System.Text.Json;
+using Voltra;
+
+namespace Voltra.Linux;
+
+internal sealed record AudioApplication(string Target, string Name);
+internal sealed record AudioSnapshot(string Status, AudioApplication[] Applications, int?[] Volumes, bool[] Waiting);
+internal sealed record AudioTarget(string Id, string Target, string Name, string[] Aliases, int Level)
+{
+    internal bool Matches(string mapping) =>
+        Target.Equals(mapping, StringComparison.OrdinalIgnoreCase) || Aliases.Contains(mapping, StringComparer.OrdinalIgnoreCase);
+}
+
+internal sealed class PipeWireAudioService : IAsyncDisposable
+{
+    private readonly CancellationTokenSource stop = new();
+    private readonly Task worker, subscription;
+    private readonly Func<Settings> settings;
+    private readonly Func<DeviceSnapshot> device;
+    private AudioSnapshot snapshot = new("Connecting to PipeWire…", [], new int?[5], new bool[5]);
+    private int topologyRevision;
+    private int volumeRevision;
+    private bool subscribed;
+    internal AudioSnapshot Snapshot => Volatile.Read(ref snapshot);
+
+    internal PipeWireAudioService(Func<Settings> settings, Func<DeviceSnapshot> device)
+    {
+        this.settings = settings;
+        this.device = device;
+        subscription = Task.Run(() => SubscribeAsync(stop.Token));
+        worker = Task.Run(() => RunAsync(stop.Token));
+    }
+
+    private async Task SubscribeAsync(CancellationToken token)
+    {
+        while (!token.IsCancellationRequested)
+        {
+            try
+            {
+                using var process = ProcessCommand.Start("pactl", "subscribe");
+                try
+                {
+                    var errors = process.StandardError.ReadToEndAsync(token);
+                    Volatile.Write(ref subscribed, true);
+                    while (await process.StandardOutput.ReadLineAsync(token) is { } line)
+                    {
+                        if (line.Contains("on sink-input", StringComparison.Ordinal) || line.Contains("on sink #", StringComparison.Ordinal)
+                            || line.Contains("on server", StringComparison.Ordinal))
+                        {
+                            if (line.Contains("'change'", StringComparison.Ordinal) && !line.Contains("on server", StringComparison.Ordinal))
+                                Interlocked.Increment(ref volumeRevision);
+                            else Interlocked.Increment(ref topologyRevision);
+                        }
+                    }
+                    string message = await errors;
+                    if (message.Length != 0)
+                        Console.Error.WriteLine(message.Trim());
+                }
+                finally
+                {
+                    Volatile.Write(ref subscribed, false);
+                    ProcessCommand.Stop(process);
+                }
+            }
+            catch (Exception ex) when (ex is IOException or Win32Exception)
+            { Console.Error.WriteLine($"Audio change subscription: {ex.Message}"); }
+
+            await Task.Delay(3500, token);
+        }
+    }
+
+    private async Task RunAsync(CancellationToken token)
+    {
+        var knobs = Enumerable.Range(0, 5).Select(_ => new VolumeTakeover()).ToArray();
+        AudioTarget[] targets = [];
+        AudioApplication[] apps = [];
+        var assignments = new string?[5];
+        var targetSets = new string?[5];
+        var actual = new int?[5];
+        int seenTopology = -1, seenVolume = -1;
+        long nextRefresh = 0, lastRefresh = 0, localWrite = 0;
+        bool connected = false;
+        bool? synced = null;
+        while (!token.IsCancellationRequested)
+        {
+            long now = Environment.TickCount64;
+            try
+            {
+                if (now >= nextRefresh && (now - lastRefresh > (Volatile.Read(ref subscribed) ? 2500 : 850) ||
+                    Volatile.Read(ref topologyRevision) != seenTopology ||
+                    (now - localWrite > 240 && Volatile.Read(ref volumeRevision) != seenVolume)))
+                {
+                    if (!connected)
+                    {
+                        string server = await ProcessCommand.RunAsync("pactl", token, "info");
+                        if (!server.Split('\n').Any(line => line.StartsWith("Server Name:", StringComparison.Ordinal) &&
+                            line.Contains("PipeWire", StringComparison.OrdinalIgnoreCase)))
+                            throw new IOException("The Pulse-compatible server is not running on PipeWire.");
+                    }
+                    seenTopology = Volatile.Read(ref topologyRevision);
+                    seenVolume = Volatile.Read(ref volumeRevision);
+                    targets = await ReadTargetsAsync(token);
+                    apps = [new(Settings.Master, "Master output"), .. targets
+                        .Where(x => x.Target != Settings.Master && x.Target.Length > 0)
+                        .DistinctBy(x => x.Target, StringComparer.OrdinalIgnoreCase)
+                        .Select(x => new AudioApplication(x.Target, x.Name)).OrderBy(x => x.Name)];
+                    connected = true;
+                    lastRefresh = Environment.TickCount64;
+                    nextRefresh = lastRefresh + 150;
+                }
+
+                if (connected)
+                {
+                    var config = settings();
+                    bool syncChanged = synced != config.Sync;
+                    synced = config.Sync;
+                    var readings = device().Levels;
+                    for (int i = 0; i < knobs.Length; i++)
+                    {
+                        var knob = knobs[i];
+                        string binding = config.Channels[i].Target.Trim();
+                        var matching = binding.Length == 0 ? [] : targets.Where(x => x.Matches(binding)).ToArray();
+                        var key = string.Join('|', matching.Select(x => x.Id).Order());
+                        if (assignments[i] != binding || targetSets[i] != key)
+                        {
+                            knob.Reset();
+                            assignments[i] = binding;
+                            targetSets[i] = key;
+                        }
+                        int? current = matching.Length == 0 ? null : (int)Math.Round(matching.Average(x => x.Level));
+                        if (knob.Actual != current || syncChanged) knob.ObserveWindows(current, config.Sync);
+                        actual[i] = current;
+                        if (readings is null)
+                        {
+                            knob.Disconnect();
+                            continue;
+                        }
+                        if (current is null)
+                        {
+                            knob.Reset();
+                            continue;
+                        }
+                        if (Volatile.Read(ref topologyRevision) != seenTopology) break;
+                        if (knob.Move(readings[i], config.Sync, config.Takeover, config.NoiseThreshold) is not int level ||
+                            matching.All(target => target.Level == level)) continue;
+
+                        foreach (var target in matching.Where(target => target.Level != level))
+                        {
+                            if (Volatile.Read(ref topologyRevision) != seenTopology) break;
+                            var command = target.Target == Settings.Master ? "set-sink-volume" : "set-sink-input-volume";
+                            await ProcessCommand.RunAsync("pactl", token, command, target.Id, level.ToString(CultureInfo.InvariantCulture) + "%");
+                            var index = Array.IndexOf(targets, target);
+                            if (index >= 0) targets[index] = target with { Level = level };
+                        }
+                        localWrite = Environment.TickCount64;
+                        knob.Written(level);
+                        actual[i] = level;
+                    }
+                    Publish("PipeWire connected", apps, actual.ToArray(), knobs.Select(k => k.Waiting).ToArray());
+                }
+            }
+            catch (Exception ex) when (ex is Win32Exception or IOException or TimeoutException or JsonException or InvalidOperationException)
+            {
+                connected = false;
+                lastRefresh = 0;
+                nextRefresh = Environment.TickCount64 + 1300;
+                targets = [];
+                apps = [];
+                foreach (var knob in knobs) knob.Reset();
+                Publish(ex is Win32Exception ? "pactl is missing. Install pulseaudio-utils." :
+                    $"PipeWire unavailable: {ex.Message}", [], new int?[5], new bool[5]);
+            }
+            // Only a changed, verified knob value produces a write. This loop coalesces serial samples.
+            await Task.Delay(75, token);
+        }
+    }
+
+    private static async Task<AudioTarget[]> ReadTargetsAsync(CancellationToken token)
+    {
+        var defaultSink = ProcessCommand.RunAsync("pactl", token, "get-default-sink");
+        var sinks = ProcessCommand.RunAsync("pactl", token, "--format=json", "list", "sinks");
+        var streams = ProcessCommand.RunAsync("pactl", token, "--format=json", "list", "sink-inputs");
+        await Task.WhenAll(defaultSink, sinks, streams);
+        return ParseTargets((await defaultSink).Trim(), await sinks, await streams);
+    }
+
+    internal static AudioTarget[] ParseTargets(string defaultSink, string sinks, string streams)
+    {
+        using var sinkDoc = JsonDocument.Parse(sinks);
+        using var streamDoc = JsonDocument.Parse(streams);
+        var result = new List<AudioTarget>();
+        foreach (var sink in sinkDoc.RootElement.EnumerateArray())
+            if (Get(sink, "name") == defaultSink && ReadLevel(sink) is int master)
+                result.Add(new(defaultSink, Settings.Master, "Master output", [], master));
+
+        foreach (var stream in streamDoc.RootElement.EnumerateArray())
+        {
+            if (!stream.TryGetProperty("properties", out var props) || props.ValueKind != JsonValueKind.Object ||
+                !stream.TryGetProperty("index", out var index) || !index.TryGetUInt32(out uint id) ||
+                ReadLevel(stream) is not int level) continue;
+            string[] aliases = new[] { Get(props, "application.id"), Get(props, "application.process.binary"),
+                    Get(props, "application.name") }
+                .Where(x => x.Length != 0).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
+            if (aliases.Length == 0) continue;
+            string name = Get(props, "application.name");
+            result.Add(new(id.ToString(CultureInfo.InvariantCulture), aliases[0],
+                name.Length == 0 ? aliases[0] : name, aliases, level));
+        }
+        return result.ToArray();
+    }
+
+    private static string Get(JsonElement element, string name) =>
+        element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";
+
+    private static int? ReadLevel(JsonElement item)
+    {
+        if (!item.TryGetProperty("volume", out var volume) || volume.ValueKind != JsonValueKind.Object) return null;
+        var channels = new List<int>();
+        foreach (var channel in volume.EnumerateObject())
+        {
+            if (channel.Value.ValueKind != JsonValueKind.Object) continue;
+            if (channel.Value.TryGetProperty("value", out var raw) && raw.TryGetInt32(out int value))
+                channels.Add((int)Math.Clamp(Math.Round(value * (100d / 65536)), 0, 100));
+            else if (int.TryParse(Get(channel.Value, "value_percent").TrimEnd('%'), CultureInfo.InvariantCulture, out int percent))
+                channels.Add(Math.Clamp(percent, 0, 100));
+        }
+        return channels.Count == 0 ? null : (int)Math.Round(channels.Average());
+    }
+
+    private void Publish(string status, AudioApplication[] apps, int?[] volumes, bool[] waiting) =>
+        Volatile.Write(ref snapshot, new(status, apps, volumes, waiting));
+
+    public async ValueTask DisposeAsync()
+    {
+        stop.Cancel();
+        try { await Task.WhenAll(worker, subscription); }
+        catch (OperationCanceledException) { }
+        finally { stop.Dispose(); }
+    }
+}
