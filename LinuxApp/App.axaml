<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Voltra.Linux.App">
    <Application.Resources>
        <FontFamily x:Key="VoltraFont">avares://LinuxApp/Assets/Fonts#Selawik</FontFamily>
        <FontFamily x:Key="MeterFont">DejaVu Sans Mono, Liberation Mono, Ubuntu Mono</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://LinuxApp/Styles/VoltraControls.axaml" />
    </Application.Styles>
</Application>
