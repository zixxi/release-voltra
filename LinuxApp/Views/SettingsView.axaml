<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Voltra.Linux.Views" x:Class="Voltra.Linux.Views.SettingsView">
  <StackPanel Spacing="8">
    <TextBlock Classes="section" Text="General" Margin="0,6,0,0" />
    <CheckBox Name="StartupToggle" Classes="switch" Content="Launch Voltra at system startup" />

    <Border Classes="rule" Margin="0,3" />
    <TextBlock Classes="section" Text="Appearance" />
    <Grid ColumnDefinitions="188,*" MinHeight="42">
      <TextBlock Text="Theme" VerticalAlignment="Center" />
      <Border Grid.Column="1" Classes="segments" HorizontalAlignment="Left" VerticalAlignment="Center">
        <UniformGrid Columns="3" Width="249">
          <RadioButton Name="ThemeDark" Classes="segment" GroupName="Theme" Content="Dark" />
          <RadioButton Name="ThemeLight" Classes="segment" GroupName="Theme" Content="Light" />
          <RadioButton Name="ThemeSystem" Classes="segment" GroupName="Theme" Content="System" />
        </UniformGrid>
      </Border>
    </Grid>
    <Grid ColumnDefinitions="188,*" MinHeight="42">
      <TextBlock Text="Accent library" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Name="Presets" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="188,*" MinHeight="42">
      <TextBlock Text="Custom accent" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Name="AccentInput" Width="125" Watermark="#RRGGBB" AutomationProperties.Name="Custom accent HEX" />
        <Button Name="OpenColor" Classes="swatch" AutomationProperties.Name="Choose custom accent color"
                ToolTip.Tip="Choose custom accent color" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Border Name="AccentSample" CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Button>
        <Button Name="ApplyAccent" Content="Apply" Width="80" />
      </StackPanel>
      <Popup Name="ColorPopup" PlacementTarget="{Binding #OpenColor}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
             IsLightDismissEnabled="True" ShouldUseOverlayLayer="True">
        <Border Width="320" TextElement.FontFamily="{StaticResource VoltraFont}" TextElement.FontSize="14" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                Background="{DynamicResource Workspace}" Padding="13" Name="PopupContent">
          <StackPanel Spacing="8">
            <TextBlock Text="Custom accent" FontSize="16" FontWeight="SemiBold" />
            <views:AccentPicker Name="Picker" Height="175" />
            <Grid ColumnDefinitions="36,132,*" ColumnSpacing="7">
              <TextBlock Text="HEX" Classes="muted" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Name="PickerHex" AutomationProperties.Name="Accent HEX" MaxLength="32" />
              <Border Grid.Column="2" Name="PickerSample" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" />
            </Grid>
            <TextBlock Name="PickerError" Classes="error" MinHeight="15" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Name="CancelPicker" Content="Cancel" Width="82" />
              <Button Name="ApplyPicker" Content="Apply" Classes="action" Width="85" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
    <TextBlock Name="AccentFeedback" Classes="error" IsVisible="False" />

    <Border Classes="rule" Margin="0,3" />
    <TextBlock Classes="section" Text="Knob mapping" />
    <CheckBox Name="FormatNames" Classes="switch" Content="Automatically format app names" />
    <TextBlock Text="Example: spotify → Spotify" Classes="muted" Margin="0,-5,0,3" />
    <CheckBox Name="SyncToggle" Classes="switch" Content="Sync external volume changes" />
    <TextBlock Text="Preserve external changes until the physical knob takes control again." Classes="muted"
               Margin="0,-5,0,3" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="188,*" MinHeight="42">
      <TextBlock Text="Knob takeover mode" VerticalAlignment="Center" />
      <Border Grid.Column="1" Name="TakeoverModes" Classes="segments" HorizontalAlignment="Left" VerticalAlignment="Center">
        <UniformGrid Columns="2" Width="249">
          <RadioButton Name="Immediate" Classes="segment" GroupName="Takeover" Content="Immediate" />
          <RadioButton Name="SoftTakeover" Classes="segment" GroupName="Takeover" Content="Soft takeover" />
        </UniformGrid>
      </Border>
    </Grid>
    <Grid ColumnDefinitions="188,*" MinHeight="42">
      <TextBlock Text="Knob movement threshold" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Name="ThresholdMenu" Width="86" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="rule" Margin="0,3" />
    <TextBlock Classes="section" Text="Device connection" />
    <Grid ColumnDefinitions="188,*" MinHeight="42">
      <TextBlock Text="Preferred port" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Name="PortMenu" Width="420" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Text="A specific port overrides automatic detection." Classes="muted" />
    <TextBlock Name="DeviceStatus" Classes="muted" TextWrapping="Wrap" />

    <Border Classes="rule" Margin="0,3" />
    <TextBlock Classes="section" Text="About" />
    <TextBlock Text="Voltra" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Name="VersionLine" Classes="muted" />
    <TextBlock Name="UpdateStatus" Classes="muted" TextWrapping="Wrap" />
    <WrapPanel ItemHeight="39" ItemSpacing="8">
      <Button Name="CheckUpdates" Content="Check for updates" Width="152" />
      <Button Name="ViewRepository" Content="View on GitHub" Width="135" />
      <Button Name="OpenRelease" Content="Open Linux release" Classes="action" IsVisible="False" />
    </WrapPanel>
    <ScrollViewer Name="NotesViewer" IsVisible="False" MaxHeight="175">
      <TextBlock Name="ReleaseNotes" TextWrapping="Wrap" />
    </ScrollViewer>
    <TextBlock Text="License · PolyForm-Noncommercial-1.0.0" Classes="muted" />
  </StackPanel>
</UserControl>
