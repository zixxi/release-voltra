<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Voltra.Linux.Views" x:Class="Voltra.Linux.Views.SettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,22,28,25" Spacing="22" MaxWidth="830" HorizontalAlignment="Stretch">
      <TextBlock Classes="heading" Text="Settings" />
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="General" />
        <ToggleSwitch Name="StartupToggle" Content="Launch Voltra at system startup" />
      </StackPanel>
      <Border BorderBrush="{DynamicResource SoftLine}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Appearance" />
          <Grid ColumnDefinitions="155,*">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Name="ThemeMenu" Width="140" />
          </Grid>
          <Grid ColumnDefinitions="155,*">
            <TextBlock Text="Accent library" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Name="Presets" Orientation="Horizontal" Spacing="6" />
          </Grid>
          <Grid ColumnDefinitions="155,*">
            <TextBlock Text="Custom accent" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
              <TextBox Name="AccentInput" Width="110" Watermark="#RRGGBB" />
              <Button Name="OpenColor">
                <StackPanel Spacing="6" Orientation="Horizontal">
                  <Border Name="AccentSample" Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                          BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource VoltraAccent}" />
                  <TextBlock Text="Pick color" />
                </StackPanel>
              </Button>
              <Button Name="ApplyAccent" Content="Apply" />
            </StackPanel>
          </Grid>
          <Border Name="AccentPanel" IsVisible="False" Width="288" HorizontalAlignment="Left" Margin="155,0,0,0"
                  Background="{DynamicResource Surface}" CornerRadius="8" Padding="13">
            <StackPanel Spacing="8">
              <views:AccentPicker Name="Picker" Height="155" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Name="CancelPicker" Content="Cancel" />
                <Button Name="ApplyPicker" Content="Apply" Classes="action" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Name="AccentFeedback" Classes="muted" Margin="155,0,0,0" IsVisible="False" />
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource SoftLine}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Knob mapping" />
          <ToggleSwitch Name="SyncToggle" Content="Sync external volume changes" />
          <Grid ColumnDefinitions="155,*">
            <TextBlock Text="Knob takeover" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Name="TakeoverMenu" Width="160" />
          </Grid>
          <Grid ColumnDefinitions="155,*">
            <TextBlock Text="Noise threshold" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Name="ThresholdMenu" Width="90" />
          </Grid>
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource SoftLine}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Device connection" />
          <Grid ColumnDefinitions="155,*">
            <TextBlock Text="Serial port" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Name="PortMenu" MaxWidth="440" HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Name="DeviceStatus" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource SoftLine}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="About" />
          <TextBlock Name="VersionLine" Classes="muted" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="CheckUpdates" Content="Check for updates" />
            <Button Name="OpenRelease" Content="Open Linux release" Classes="action" IsVisible="False" />
          </StackPanel>
          <TextBlock Name="UpdateStatus" Classes="muted" TextWrapping="Wrap" />
          <ScrollViewer Name="NotesViewer" IsVisible="False" MaxHeight="175">
            <TextBlock Name="ReleaseNotes" TextWrapping="Wrap" />
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
