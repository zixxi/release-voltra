<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Voltra.Linux.Views" x:Class="Voltra.Linux.Views.MainWindow"
        Title="Voltra" Width="1100" Height="690" MinWidth="580" MinHeight="360"
        WindowStartupLocation="CenterScreen" Icon="avares://LinuxApp/Assets/Icons/voltra-256.png">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="16*" MinWidth="136" MaxWidth="176" />
      <ColumnDefinition Width="84*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="8,16,8,12" RowDefinitions="Auto,*,Auto,Auto">
        <Grid>
          <StackPanel Spacing="4">
            <Button Name="DashboardButton" Classes="nav selected" Content="Dashboard" />
            <Button Name="OledButton" Classes="nav" Content="OLED" />
            <Button Name="SettingsButton" Classes="nav" Content="Settings" />
          </StackPanel>
          <Border Name="NavMarker" Width="3" Height="24" Margin="1,5,0,0" CornerRadius="1.5"
                  Background="{DynamicResource VoltraAccent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                  IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
          </Border>
        </Grid>
        <StackPanel Name="ConnectionStatus" Grid.Row="2" Margin="4,0,3,2" Spacing="4" ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <Ellipse Name="ConnectionDot" Width="7" Height="7" VerticalAlignment="Center" />
            <TextBlock Name="ConnectionTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Name="ConnectionDetail" Classes="muted" FontSize="{StaticResource StatusSize}" Margin="14,0,0,0"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Name="AudioStatus" Classes="muted" FontSize="{StaticResource StatusSize}" Margin="14,0,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="2,6,2,0" Spacing="3">
          <Border Height="1" Background="{DynamicResource Line}" />
          <TextBlock Text="Active profile" Classes="muted" FontSize="12" />
          <Button Name="ProfilePicker" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <PathIcon Width="13" Height="13" Data="M8,1 A3,3 0 1 1 8,7 A3,3 0 1 1 8,1 M1,15 C1,7 15,7 15,15 Z" />
              <TextBlock Name="ActiveProfileName" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <PathIcon Grid.Column="2" Width="9" Height="5" Data="M0,0 L5,5 L10,0 L8,0 L5,3 L2,0 Z" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="profiles">
                <StackPanel Name="ProfileActions">
                  <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="ProfileChoices" />
                  </ScrollViewer>
                  <Border Classes="rule" Margin="3,3" />
                  <Button Name="ManageProfiles" Classes="profileEntry" Content="Manage profiles…" Padding="4,0" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <ScrollViewer Name="PageScroll" ClipToBounds="True">
        <Grid Name="PageContent" RowDefinitions="Auto,*" Margin="26,16,24,16">
          <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
          <Border Height="46" Padding="2,0,0,0">
            <TextBlock Name="PageHeading" Text="Dashboard" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <Grid Grid.Row="1">
            <views:DashboardView Name="Dashboard" />
            <views:OledView Name="Oled" IsVisible="False" />
            <views:SettingsView Name="Preferences" IsVisible="False" />
          </Grid>
        </Grid>
      </ScrollViewer>
      <TextBlock Name="Notice" Grid.Row="1" Margin="32,0,26,12" Classes="error" TextWrapping="Wrap" IsVisible="False" />
    </Grid>
  </Grid>
</Window>
