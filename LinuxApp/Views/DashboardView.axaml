<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Voltra.Linux.Views" x:Class="Voltra.Linux.Views.DashboardView">
  <StackPanel>
    <Grid Name="DisplayPanel" ColumnDefinitions="49*,1,51*" MinHeight="260">
      <views:OledPreview Name="Preview" Margin="0,0,18,0" />
      <Border Grid.Column="1" Margin="0,4,0,9" Background="{DynamicResource Line}" />
      <StackPanel Grid.Column="2" Margin="24,0,0,0" Spacing="9">
        <TextBlock Classes="section" Text="OLED" Height="30" />
        <Grid ColumnDefinitions="108,*">
          <TextBlock Text="Idle page" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Name="IdlePageMenu" Width="158"
                    AutomationProperties.Name="OLED idle page" />
        </Grid>
        <TextBlock Classes="muted" Text="Knob overlay returns to idle after 3 seconds." TextWrapping="Wrap" />
        <Button Name="OpenOled" Content="OLED settings" Width="134" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
    <Border Classes="rule" Margin="0,11" />
    <Grid ColumnDefinitions="*,Auto" MinHeight="44">
      <TextBlock Classes="section" Text="Live mixer" Margin="4,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="1" Name="EditMapping" Content="Edit mappings" Width="132" VerticalAlignment="Center" />
    </Grid>
    <Grid Name="Gauges" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" Height="224" />
  </StackPanel>
</UserControl>
