<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Voltra.Linux.Views.DashboardView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,22,28,25" Spacing="22">
      <TextBlock Classes="heading" Text="Dashboard" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Name="DeviceStatus" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Name="DeviceDetail" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Column="1" Name="AudioStatus" TextWrapping="Wrap" Classes="muted" />
      </Grid>
      <Border BorderBrush="{DynamicResource SoftLine}" BorderThickness="0,1,0,1" Padding="0,20">
        <Grid Name="Gauges" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5" />
      </Border>
      <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="24">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Channel mappings" />
          <StackPanel Name="MappingRows" Spacing="7" />
          <Button Name="ApplyMappings" Content="Apply mappings" Classes="action" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Classes="section" Text="OLED" />
          <Border Background="#090B10" CornerRadius="8" Padding="10">
            <Image Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
          </Border>
          <TextBlock Name="OledStatus" TextWrapping="Wrap" Classes="muted" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
