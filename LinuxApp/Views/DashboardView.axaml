<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Voltra.Linux.Views" x:Class="Voltra.Linux.Views.DashboardView">
  <StackPanel>
    <Grid ColumnDefinitions="49*,1,51*">
      <views:OledPreview Name="Preview" Margin="0,0,12,0" />
      <Border Grid.Column="1" Margin="0,3,0,2" Background="{DynamicResource Line}" />
      <StackPanel Grid.Column="2" Margin="16,0,0,0" Spacing="6">
        <TextBlock Classes="section" Text="OLED" Height="28" VerticalAlignment="Center" />
        <WrapPanel ItemSpacing="10" LineSpacing="4">
          <TextBlock Text="Idle page" MinWidth="56" VerticalAlignment="Center" />
          <ComboBox Name="IdlePageMenu" Width="134"
                    AutomationProperties.Name="OLED idle page" />
        </WrapPanel>
        <TextBlock Classes="muted" Text="Knob overlay returns to idle after 3 seconds." TextWrapping="Wrap" />
        <Button Name="OpenOled" Content="OLED settings" Width="116" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
    <Border Classes="rule" Margin="0,12,0,6" />
    <Grid ColumnDefinitions="*,Auto" MinHeight="36">
      <TextBlock Classes="section" Text="Live mixer" Margin="2,0,0,0" VerticalAlignment="Center" />
      <Button Grid.Column="1" Name="EditMapping" Content="Edit mappings" Width="116" VerticalAlignment="Center" />
    </Grid>
    <Grid Name="Gauges" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" />
  </StackPanel>
</UserControl>
